{
  "version": 5,
  "configurePresets": [
    {
      "name": "x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/x64"
    },
    {
      "name": "x86",
      "inherits": "x64",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/x86"
    }
  ],
  "buildPresets": [
    { "name": "release-x64", "configurePreset": "x64", "configuration": "Release" },
    { "name": "release-x86", "configurePreset": "x86", "configuration": "Release" },
    { "name": "debug-x64", "configurePreset": "x64", "configuration": "Debug" },
    { "name": "debug-x86", "configurePreset": "x86", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "release-x64",
      "configurePreset": "x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release-x86",
      "configurePreset": "x86",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug-x64",
      "configurePreset": "x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug-x86",
      "configurePreset": "x86",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
